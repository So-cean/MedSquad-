# EDMAS backend 本地配置文件。
# 复制此文件为 backend/.env，并填入真实值。
# backend/.env 已被 .gitignore 排除，不会被提交到仓库。

EDMAS_APP_NAME=EDMAS Backend
EDMAS_AGENT_PROVIDER=mock
EDMAS_DETERMINISTIC=true
EDMAS_INTENT_PROVIDER=openai
EDMAS_INTENT_FALLBACK_PROVIDER=template

# 可选覆盖项。
# EDMAS_RUNTIME_DIR=backend/runtime
# EDMAS_GODOT_TIMELINE_OUTPUT=data/timelines/headache_triage.timeline.json

# OpenAI 兼容 API 配置（用于真实意图解析和智能体计划生成）。
# 使用 Gitee AI 等兼容服务时，填写对应的 base_url 和 model。
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=120

# 离线开发模式（完全不依赖 API）：
# EDMAS_AGENT_PROVIDER=mock
# EDMAS_INTENT_PROVIDER=template
# EDMAS_INTENT_FALLBACK_PROVIDER=template

# 向后兼容的别名（如果你的本地 .env 已经使用它们）：
# api_key=your_api_key_here
# base_url=https://api.openai.com/v1
# model_name=gpt-4.1-mini